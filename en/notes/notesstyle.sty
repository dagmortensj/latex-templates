\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notesstyle}[2026/05/07 v1.2 Notes style — JHEP/CUP inspired]

% =================================================
% PHILOSOPHY
%
% This style is for long-form theoretical physics
% and mathematics NOTES (not papers).
%
% Design priorities:
%  - calm vertical rhythm
%  - readable mathematics
%  - strong but quiet structure
%  - typographic consistency
%
% The style is intentionally conservative.
% =================================================


% =================================================
% FONT & MICROTYPOGRAPHY
% =================================================
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% =================================================
% PAGE GEOMETRY (A4, SYMMETRIC)
%
% Optimized for:
%  - printed notes
%  - long derivations
%  - margin annotations if needed
% =================================================
\RequirePackage[
  a4paper,
  left=3.0cm,
  right=3.0cm,
  top=2.7cm,
  bottom=3.0cm
]{geometry}


% =================================================
% PARAGRAPH & LINE SPACING
%
% Classical book-like paragraphs:
%  - indentation
%  - no paragraph skip
% =================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.07}


% =================================================
% DISPLAYED EQUATION SPACING
%
% Notes benefit from generous space around
% displayed mathematics, especially after
% short lead-in lines ("so that", "thus", etc.).
%
% Short-skip and normal skip are intentionally
% equalized to avoid cramping.
% =================================================
\setlength{\abovedisplayskip}{14.2pt plus 4.25pt minus 4.25pt}
\setlength{\belowdisplayskip}{14.2pt plus 4.25pt minus 4.25pt}

\setlength{\abovedisplayshortskip}{14.2pt plus 4.25pt minus 4.25pt}
\setlength{\belowdisplayshortskip}{14.2pt plus 4.25pt minus 4.25pt}


% =================================================
% SECTIONING
%
% Structural hierarchy is indicated by:
%  - size
%  - weight
%  - small caps
%
% Subsubsections are intentionally omitted.
% =================================================
\RequirePackage{titlesec}

% Sections
\titleformat{\section}
  {\normalfont\Large\bfseries\scshape}
  {\thesection.}{0.8em}{}

\titlespacing*{\section}
  {0pt}{4.5ex plus 1.5ex minus .5ex}{2.4ex plus .4ex}

% Subsections
\titleformat{\subsection}
  {\normalfont\large\bfseries\scshape}
  {\thesubsection.}{0.8em}{}

\titlespacing*{\subsection}
  {0pt}{4.0ex plus 1.2ex minus .4ex}{1.8ex plus .4ex}


% =================================================
% PAGE STYLE
%
% Notes use plain pages:
%  - no running headers
%  - page number centered at bottom
% =================================================
\pagestyle{plain}


% =================================================
% TITLE BLOCK
%
% Calm, book-inspired title layout.
% Uses \maketitle for simplicity and robustness.
% =================================================
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \begin{center}
    {\Large\scshape \@title \par}
    \vspace{2.0em}
    {\normalsize \@author \par}
    \vspace{0.6em}
    {\small \@date \par}
  \end{center}
  \vspace{2.5em}
}
\makeatother


% =================================================
% ABSTRACT
%
% Narrower text block, classic style.
% Spacing is matched to overall notes rhythm.
%
% We redefine the abstract environment to:
%  - centre a small-caps "Abstract" label
%  - constrain the body to 88% of the text width
%  - reset line spacing inside the block
% =================================================
\makeatletter
\renewenvironment{abstract}{%
  \par
  \centering
  {\small\bfseries\scshape \abstractname\par}
  \vspace{10pt}
  \begin{minipage}{0.88\textwidth}
    \small
    \setstretch{1.0}
}{%
  \end{minipage}
  \par
  \vspace{2.2em}
}
\makeatother


% =================================================
% TABLE OF CONTENTS
%
% JHEP-style framing:
%
% ----------------------------
% Contents
% sections
% ----------------------------
%
% Dot leaders are removed explicitly using
% documented interfaces (tocloft), not internals.
% =================================================
\RequirePackage{tocloft}
\RequirePackage{etoolbox}

% No dot leaders
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

% Optional width tuning (safe defaults)
\setlength{\cftsecnumwidth}{2.5em}
\setlength{\cftsubsecnumwidth}{3.0em}

% Horizontal rules above and below ToC.
% \pretocmd / \apptocmd (from etoolbox) inject code
% before/after \tableofcontents without overriding it.
\newcommand{\afterTocSpace}{\bigskip\medskip}
\newcommand{\afterTocRuleSpace}{\bigskip\bigskip}

\pretocmd{\tableofcontents}{%
  \hrule
  \vspace{1.5ex}
}{}{}

\apptocmd{\tableofcontents}{%
  \afterTocSpace
  \hrule
  \afterTocRuleSpace
}{}{}


% =================================================
% CITATIONS
%
% Numerical citations in square brackets, sorted and
% compressed into ranges, e.g. \cite{a,b,c} -> [1-3].
%
% natbib must be loaded before hyperref.
%
% Usage:
%   \cite{key}             [1]
%   \cite{k1,k2,k3}        [1-3]
%   \bibliographystyle{unsrtnat} in main.tex
%   \bibliography{...}     in main.tex
% =================================================
\RequirePackage[numbers,sort&compress]{natbib}


% =================================================
% HYPERLINKS
%
% Dark red, print-safe.
% Loaded last.
% =================================================
\RequirePackage{xcolor}
\definecolor{darkred}{RGB}{120,20,20}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred,
  linktoc=page
}


% =================================================
% END OF FILE
% =================================================
\endinput
