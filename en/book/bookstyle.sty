\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bookstyle}[2026/05/07 v1.8 — frozen CUP-style book layout]

% =================================================
% STATUS: FROZEN
%
% This style file defines the typographic appearance
% of an academic monograph (CUP-style).
%
% Physical paper size (A4, B5, etc.) MUST be set
% via the document class, e.g.:
%
%   \documentclass[a4paper]{book}
%   \documentclass[b5paper]{book}
%
% Do NOT modify this file during writing.
% Copy and version it if changes are needed.
% =================================================


% =================================================
% CORE FONT SETUP
%
% Latin Modern with T1 encoding:
%  - high-quality PDF output
%  - proper hyphenation
%  - stable across platforms
% =================================================
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}


% =================================================
% MICROTYPOGRAPHY
%
% Subtle protrusion and expansion improve justification
% without visible distortion. Tracking enabled for
% small caps and headings.
% =================================================
\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% =================================================
% PAGE GEOMETRY
%
% Margins are defined independently of paper size.
% They adapt automatically to A4, B5, etc.
%
% Inner / outer margins are asymmetric for binding.
% =================================================
\RequirePackage[
  inner=2.7cm,
  outer=2.3cm,
  top=2.3cm,
  bottom=2.7cm
]{geometry}


% =================================================
% PARAGRAPH & LINE SPACING
%
% Classical book typography:
%  - indented paragraphs
%  - no inter-paragraph skip
%  - slightly loose leading for readability
% =================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.07}


% =================================================
% DISPLAYED EQUATION SPACING
%
% Explicit control ensures consistent visual rhythm around
% mathematics, shared with the notes style so the two read as a
% family. Only the ABOVE skip shrinks after a short lead-in line
% (a short line already leaves trailing space), and never to zero;
% the BELOW skip is always the full value, so the gap under an
% equation never depends on what came above it:
%     above 12pt   above (after short line)  7pt
%     below 12pt   below (always)           12pt
%
% Applied via \AtBeginDocument: LaTeX's \normalsize (run by
% \begin{document}) resets all four display skips to the class
% defaults, so values set here in the preamble would be silently
% overridden. Setting them after \normalsize makes them take
% effect; later size changes are grouped and restore them on exit.
% =================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\abovedisplayshortskip}{7pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayshortskip}{12pt plus 3pt minus 3pt}%
}


% =================================================
% CAPTIONS
%
% font=small      -- one step below body text (JHEP/CUP standard)
% labelfont=bf    -- bold "Figure 1." label (JHEP/CUP standard)
% labelsep=period -- period after number, not colon (JHEP style)
% justification: default (singlelinecheck=true) -- single-line captions
%   are centred automatically; multi-line captions are justified
% =================================================
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}


% =================================================
% SECTIONING & CHAPTER DESIGN (MAIN MATTER)
%
% titlesec provides full control over hierarchy
% and spacing, independent of the base class.
% =================================================
\RequirePackage{titlesec}

% ------------------ Main chapters ----------------
% Uses \chaptername (babel-localized: "Chapter" / "Kapittel" / ...)
\titleformat{\chapter}[display]
  {\normalfont}
  {\filcenter\scshape \chaptername\ \thechapter}
  {3ex}
  {\filcenter\Huge\MakeUppercase}

\titlespacing*{\chapter}
  {0pt}{3.5ex plus 1ex minus .2ex}{11ex plus 2ex minus .5ex}

% ------------------ Sections ---------------------
\titleformat{\section}
  {\normalfont\bfseries\large}
  {\thesection}{1em}{}

\titlespacing*{\section}
  {0pt}{2.5ex plus 1ex minus .2ex}{1.5ex plus .2ex}

% ------------------ Subsections ------------------
\titleformat{\subsection}
  {\normalfont\bfseries\normalsize}
  {\thesubsection}{1em}{}

\titlespacing*{\subsection}
  {0pt}{2ex plus .8ex minus .2ex}{1.2ex plus .2ex}


% =================================================
% SECTION NUMBERING
%
% Sections, subsections, and below are unnumbered
% but still appear in the table of contents.
% Parts and chapters remain numbered.
% =================================================
\setcounter{secnumdepth}{0}


% =================================================
% PART PAGES
%
% Silent, centered, unnumbered pages.
% Visual rhythm matches chapter and title pages.
% =================================================
% Uses \partname (babel-localized: "Part" / "Del" / ...)
\titleformat{\part}[display]
  {\normalfont}
  {\filcenter\scshape \partname\ \thepart}
  {3ex}
  {\filcenter\LARGE\MakeUppercase}

\titlespacing*{\part}
  {0pt}{0.35\textheight}{0.35\textheight}

\assignpagestyle{\part}{empty}


% =================================================
% DROP CAPS FOR CHAPTER OPENINGS
%
% Explicit macro keeps usage intentional.
% No automatic injection.
% =================================================
\RequirePackage{lettrine}

\newcommand{\chapteropening}[2]{%
  \lettrine[
    lines=3,
    loversize=0.0,
    lraise=0.0,
    findent=0.1em,
    nindent=0em
  ]{#1}{\textsc{#2}}%
}


% =================================================
% TABLE OF CONTENTS (BOOK STYLE)
%
% Clean, quiet hierarchy:
%  - no framing rules
%  - restrained spacing
%  - title styled like a chapter
% =================================================
\RequirePackage{tocloft}

\renewcommand{\cfttoctitlefont}{\Huge\scshape}
\renewcommand{\cftaftertoctitle}{\par\vspace{2ex}}

\renewcommand{\cftchapleader}{\hfill}
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

\setlength{\cftchapnumwidth}{2.5em}
\setlength{\cftsecnumwidth}{3.0em}
\setlength{\cftsubsecnumwidth}{3.5em}

\setlength{\cftbeforechapskip}{6pt}
\setlength{\cftbeforesecskip}{2.5pt}
\setlength{\cftbeforesubsecskip}{1.5pt}

\newcommand{\booktoc}{%
  \tableofcontents
}


% =================================================
% HEADERS & PAGE STYLES
%
% fancyhdr is used explicitly and locally.
% No global redefinition of 'plain'.
%
% Position codes used below:
%   L = left,   C = centre, R = right
%   E = even page (verso), O = odd page (recto)
% In two-side layout, page numbers go on the outer
% edge and section/chapter marks on the inner.
% =================================================
\RequirePackage{fancyhdr}
\setlength{\headheight}{14pt}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ------------------ Main matter pages -------------
\fancypagestyle{chapterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

% ------------------ Chapter opening pages --------
\fancypagestyle{chapteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}

% ------------------ Front matter pages ------------
\fancypagestyle{frontmatterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

\fancypagestyle{frontmatteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}


% =================================================
% PATCH MAIN-MATTER CHAPTER OPENINGS ONLY
%
% Redirect chapter opening pages away from 'plain'
% without affecting front-matter behavior.
% =================================================
\RequirePackage{etoolbox}
\makeatletter

\patchcmd{\chapter}
  {\thispagestyle{plain}}
  {\thispagestyle{chapteropen}}
  {}{}

\makeatother


% =================================================
% FRONT-MATTER CHAPTER MACRO
%
% Used for Preface, Acknowledgments, etc.
%
% Design goals:
%  - unnumbered
%  - slightly smaller than main chapters
%  - flush left
%  - restrained spacing
%  - correct page-style behavior
%
% NOTE:
%  - First paragraph indentation is handled explicitly
%    in the document using \noindent.
% =================================================
\makeatletter

\newcommand{\frontchapter}[1]{%
  \cleardoublepage
  \thispagestyle{frontmatteropen}

  % Set running header text (avoids "Chapter 0")
  \markboth{#1}{}

  % Heading block
  \vspace*{3ex}
  {\noindent\LARGE\bfseries #1\par}
  \vspace{3ex}
}

\makeatother


% =================================================
% HEADER MARKS
%
% Clean, minimal running headers.
% =================================================
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}

\pagestyle{chapterstyle}


% =================================================
% TITLE PAGE
%
% Explicit, robust title page.
% No reliance on \maketitle.
% =================================================
\makeatletter

\def\@subtitle{}
\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}

\newcommand{\booktitlepage}{%
  \begin{titlepage}
    \thispagestyle{empty}

    \vspace*{0.18\textheight}

    \begin{center}
      {\Huge\scshape \@title \par}

      \ifx\@subtitle\@empty\else
        \vspace{1.6em}
        {\Large\itshape \@subtitle \par}
      \fi

      \vspace{3em}
      {\large \@author \par}
    \end{center}

    \vfill

    \begin{center}
      {\normalsize\itshape \@date \par}
    \end{center}
  \end{titlepage}
}

\makeatother


% =================================================
% DEDICATION PAGE
%
% Recto page with a single short italic line,
% centered horizontally, set in the upper third
% of the page. Followed by a blank verso.
%
% Usage:
%   \dedicationpage{To my parents.}
% =================================================
\newcommand{\dedicationpage}[1]{%
  \cleardoublepage
  \thispagestyle{empty}
  \vspace*{0.25\textheight}
  \begin{center}
    \itshape #1
  \end{center}
  \vfill
  \cleardoublepage
}


% =================================================
% CITATIONS
%
% Numerical superscript citations, placed exactly
% where written in the source (no auto-shifting past
% punctuation). Multiple keys are sorted and
% compressed into ranges, e.g. \cite{a,b,c} -> 1-3.
%
% Usage:
%   \cite{key}         in the text
%   \bibliography{...} in main.tex back matter
% =================================================
\RequirePackage[superscript,nomove]{cite}

% Bibliography list labels: "1." instead of "[1]",
% to match the superscript style used in the text.
\makeatletter
\renewcommand{\@biblabel}[1]{#1.}
\makeatother


% =================================================
% HYPERLINKS
%
% MUST BE LOADED LAST.
% Subtle, print-safe appearance.
% =================================================
\RequirePackage{xcolor}
\definecolor{linkblack}{RGB}{0,0,0}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=linkblack,
  citecolor=linkblack,
  urlcolor=linkblack,
  linktoc=page
}

% Override hyperref's default of colouring TOC page
% numbers — keep them black to match the rest.
\makeatletter
\renewcommand{\cftchappagefont}{\normalfont\color{black}}
\renewcommand{\cftsecpagefont}{\normalfont\color{black}}
\renewcommand{\cftsubsecpagefont}{\normalfont\color{black}}
\makeatother


% =================================================
% END OF FILE
% =================================================
\endinput
