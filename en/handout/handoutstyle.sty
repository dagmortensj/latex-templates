\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{handoutstyle}[2026/06/02 v1.2 Handout style — calm classic typography for problem sheets]

% ============================================================
% PHILOSOPHY
%
% This style is for physics / mathematics handouts and
% problem sheets (not articles or monographs).
%
% Typographically it belongs to the same family as the
% notes and book styles — calm, classic Latin Modern —
% but lighter: quiet headings, generous margins, and no
% table of contents or bibliography by default.
%
% Design principles:
%  - conservative typography
%  - predictable spacing
%  - minimal redefinitions
%  - no fragile list hacks
%
% When in doubt, prefer stability over cleverness.
% ============================================================


% ============================================================
% FONT ENCODING & MICROTYPOGRAPHY
% ============================================================
%
% Latin Modern is the standard, safe default for PDFLaTeX.
% microtype improves justification subtly without surprises.
%
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% PAGE GEOMETRY
% ============================================================
%
% A4 layout with generous margins.
% Optimized for printed handouts and annotation.
%
\RequirePackage[
  a4paper,
  left=3.0cm,
  right=3.0cm,
  top=2.6cm,
  bottom=3.0cm
]{geometry}


% ============================================================
% PARAGRAPH & LINE SPACING
% ============================================================
%
% Classic book-like paragraphs:
%  - indented
%  - no vertical paragraph skip
%
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

% Slightly relaxed line spacing for readability
\RequirePackage{setspace}
\setstretch{1.04}


% ============================================================
% SECTION HEADINGS
% ============================================================
%
% Sections are intentionally quiet:
%  - no oversized fonts
%  - no decorative rules
%
\RequirePackage{titlesec}

\titleformat{\section}
  {\normalfont\normalsize\bfseries}
  {\thesection}{0.6em}{}

\titlespacing*{\section}
  {0pt}
  {6ex plus 2ex minus .8ex}
  {2ex plus .5ex}


% ============================================================
% PAGE STYLE
% ============================================================
%
% Plain pages: no headers, centered page number.
%
\pagestyle{plain}


% ============================================================
% TITLE BLOCK
% ============================================================
%
% Simple, calm title layout.
% Uses \maketitle for robustness.
%
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \begin{center}
    \vspace*{1em}
    {\Large\normalfont\scshape\lsstyle \@title\par}
    \vspace{1.6em}
    {\footnotesize\normalfont\scshape \@date\par}
    \vspace{3em}
  \end{center}
}
\makeatother


% ============================================================
% COLORS
% ============================================================
%
% Dark red chosen to be print-safe and unobtrusive.
%
\RequirePackage{xcolor}
\definecolor{darkred}{RGB}{120,20,20}


% ============================================================
% THEOREM-LIKE ENVIRONMENTS
% ============================================================
%
% Standard structured environments for mathematical
% handouts:
%   theorem      numbered per section (Theorem 1.1, ...)
%   definition   shares the theorem counter
%   remark       shares the theorem counter
%
% amsthm also underpins the exercise environment below,
% so it is loaded once here.
%
% Label names use \providecommand so they can be
% localized before this style is loaded, e.g.
%   \providecommand{\theoremname}{Teorem}
% (matching the \exercisename hook used below).
%
\RequirePackage{amsthm}

\providecommand{\theoremname}{Theorem}
\providecommand{\definitionname}{Definition}
\providecommand{\remarkname}{Remark}

\theoremstyle{plain}
\newtheorem{theorem}{\theoremname}[section]

\theoremstyle{definition}
\newtheorem{definition}[theorem]{\definitionname}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{\remarkname}


% ============================================================
% SEPARATOR RULE
% ============================================================
%
% A rule identical in width to the footnote rule, set in
% dark red. Use between content blocks (after exercises,
% between examples, topic shifts within a section, ...).
% A visual cue that does not compete with section headings.
%
% \let\orig@footnoterule\footnoterule
%   Saves the original footnote rule before any
%   downstream package can redefine \footnoterule,
%   so we can reuse its width here regardless.
%
% The leading \par closes any open paragraph, so \separator
% is safe to call directly after running text.
%
\makeatletter
\let\orig@footnoterule\footnoterule
\newcommand{\separator}{%
  \par
  \vspace{3.5ex plus 1.5ex minus .5ex}
  {\color{darkred}\orig@footnoterule}
  \vspace{1.2ex}
}
\makeatother


% ============================================================
% EXERCISE ENVIRONMENT
% ============================================================
%
% Exercises are implemented using amsthm (loaded above):
%  - numbered per section (Exercise 2.1, 2.2, ...)
%  - slightly indented using a quote environment
%  - visually less prominent than section headings
%
% \newtheoremstyle arguments, in order:
%   space above, space below, body font, indent,
%   head font, head punctuation,
%   space between head and body, custom head spec.
\newtheoremstyle{handoutex}
  {1ex}              % space above
  {1ex}              % space below
  {\normalfont}      % body font
  {0pt}              % indent
  {\bfseries}        % head font
  {}                 % head punctuation
  {\newline}         % space between head and body
  {}                 % custom head spec (empty = default)

% Exercise label name. Override before loading to localize:
%   \providecommand{\exercisename}{Oppgave} % Norwegian
\providecommand{\exercisename}{Exercise}

\theoremstyle{handoutex}
\newtheorem{exerciseinner}{\exercisename}[section]
\renewcommand{\theexerciseinner}{\thesection.\arabic{exerciseinner}}

% Restore amsthm's conventional default, so any extra
% theorem-like environment added later (in main.tex) starts
% from \theoremstyle{plain} rather than the exercise style.
\theoremstyle{plain}

% The amsthm style sets the body on a new line after the bold
% label (the {\newline} head/body separator above). The
% \leavevmode\par\vspace{-2ex} then pulls the body up to a
% tight gap under the label. -2ex is font-relative, so it
% tracks the line height across sizes. (A custom head spec
% was tried instead, but it conflicts with the quote wrapper;
% this is the stable form.)
\newenvironment{exercise}
{%
  \par
  \begin{quote}
  \begin{exerciseinner}\leavevmode\par\vspace{-2ex}
}
{%
  \end{exerciseinner}
  \end{quote}
  \vspace{3.5ex plus 1.5ex minus .8ex}
}


% ============================================================
% SUBPROBLEMS (a), b), c))
% ============================================================
%
% Subproblems use a dedicated 'subproblems' list rather than
% redefining enumerate, so ordinary numbered lists remain
% available for normal use.
%
% Explanatory prose between subproblems should be written
% as normal text outside the environment; numbering is then
% picked up again with \begin{subproblems}[resume].
%
\RequirePackage{enumitem}

% \newlist{<name>}{<type>}{<max depth>}
% Defines 'subproblems' as an enumerate-type list, one level.
\newlist{subproblems}{enumerate}{1}

\setlist[subproblems]{%
  label=\alph*),
  leftmargin=2.2em,
  labelsep=0.6em,
  itemsep=0.8ex,
  parsep=0.8ex,
  topsep=0.8ex
}


% ============================================================
% HYPERLINKS
% ============================================================
%
% Loaded last. Dark red links suitable for print.
%
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred
}

% ============================================================
% END OF FILE
% ============================================================
\endinput
