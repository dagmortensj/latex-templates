\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bokstil}[2026/05/07 v1.8 — frosset CUP-stil bokoppsett]

% =================================================
% STATUS: FROSSET
%
% Denne stilfilen definerer det typografiske utseendet
% til en akademisk monografi (CUP-stil).
%
% Fysisk papirstørrelse (A4, B5, osv.) MÅ settes
% via dokumentklassen, f.eks.:
%
%   \documentclass[a4paper]{book}
%   \documentclass[b5paper]{book}
%
% IKKE endre denne filen under skriving.
% Kopier og versjoner den hvis endringer trengs.
% =================================================


% =================================================
% KJERNEFONT
%
% Latin Modern med T1-koding:
%  - høy PDF-kvalitet
%  - korrekt orddeling
%  - stabil på tvers av plattformer
% =================================================
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}


% =================================================
% MIKROTYPOGRAFI
%
% Subtil protrusion og ekspansjon forbedrer justering
% uten synlig forvrengning. Tracking aktivert for
% kapiteler og overskrifter.
% =================================================
\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% =================================================
% SIDEGEOMETRI
%
% Margene er definert uavhengig av papirstørrelse.
% De tilpasser seg automatisk A4, B5, osv.
%
% Innside- og utsidemargene er asymmetriske for innbinding.
% =================================================
\RequirePackage[
  inner=2.7cm,
  outer=2.3cm,
  top=2.3cm,
  bottom=2.7cm
]{geometry}


% =================================================
% AVSNITT- OG LINJEAVSTAND
%
% Klassisk boktypografi:
%  - innrykkede avsnitt
%  - ingen linjeskift mellom avsnitt
%  - lett luftig linjeavstand for lesbarhet
% =================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.07}


% =================================================
% AVSTAND RUNDT VISTE LIGNINGER
%
% Eksplisitt kontroll sikrer konsekvent visuell rytme rundt
% matematikk, delt med notatstilen så de to leses som en familie.
% Bare OVER-skipet krymper etter en kort innledende linje (en kort
% linje gir allerede luft der), og aldri til null; UNDER-skipet er
% alltid full verdi, så luften under en ligning aldri avhenger av
% hva som stod over:
%     over 12pt    over (etter kort linje)   7pt
%     under 12pt   under (alltid)           12pt
%
% Settes via \AtBeginDocument: LaTeX sin \normalsize (kjørt av
% \begin{document}) nullstiller alle fire display-skip til
% klassens standard, så verdier satt her i preamblet ville blitt
% stille overstyrt. Ved å sette dem etter \normalsize trer de i
% kraft; senere størrelsesendringer er grupperte og gjenoppretter
% dem når de avsluttes.
% =================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\abovedisplayshortskip}{7pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayshortskip}{12pt plus 3pt minus 3pt}%
}


% =================================================
% SEKSJONERING OG KAPITTELDESIGN (HOVEDMATERIALE)
%
% titlesec gir full kontroll over hierarki og avstander,
% uavhengig av basisklassen.
% =================================================
\RequirePackage{titlesec}

% ------------------ Hovedkapitler ----------------
% Bruker \chaptername (babel-lokalisert: "Kapittel" / "Chapter" / ...)
\titleformat{\chapter}[display]
  {\normalfont}
  {\filcenter\scshape \chaptername\ \thechapter}
  {3ex}
  {\filcenter\Huge\MakeUppercase}

\titlespacing*{\chapter}
  {0pt}{3.5ex plus 1ex minus .2ex}{11ex plus 2ex minus .5ex}

% ------------------ Seksjoner --------------------
\titleformat{\section}
  {\normalfont\bfseries\large}
  {\thesection}{1em}{}

\titlespacing*{\section}
  {0pt}{2.5ex plus 1ex minus .2ex}{1.5ex plus .2ex}

% ------------------ Underseksjoner ---------------
\titleformat{\subsection}
  {\normalfont\bfseries\normalsize}
  {\thesubsection}{1em}{}

\titlespacing*{\subsection}
  {0pt}{2ex plus .8ex minus .2ex}{1.2ex plus .2ex}


% =================================================
% SEKSJONSNUMMERERING
%
% Seksjoner, underseksjoner og dypere er unummererte
% men vises fortsatt i innholdsfortegnelsen.
% Deler og kapitler beholder nummereringen.
% =================================================
\setcounter{secnumdepth}{0}


% =================================================
% DELSIDER
%
% Stille, sentrerte, unummererte sider.
% Visuell rytme matcher kapittel- og tittelsider.
% =================================================
% Bruker \partname (babel-lokalisert: "Del" / "Part" / ...)
\titleformat{\part}[display]
  {\normalfont}
  {\filcenter\scshape \partname\ \thepart}
  {3ex}
  {\filcenter\LARGE\MakeUppercase}

\titlespacing*{\part}
  {0pt}{0.35\textheight}{0.35\textheight}

\assignpagestyle{\part}{empty}


% =================================================
% INITIALER FOR KAPITTELÅPNING
%
% Eksplisitt makro holder bruken bevisst.
% Ingen automatisk innsetting.
% =================================================
\RequirePackage{lettrine}

\newcommand{\chapteropening}[2]{%
  \lettrine[
    lines=3,
    loversize=0.0,
    lraise=0.0,
    findent=0.1em,
    nindent=0em
  ]{#1}{\textsc{#2}}%
}


% =================================================
% INNHOLDSFORTEGNELSE (BOKSTIL)
%
% Rent, stille hierarki:
%  - ingen rammer
%  - tilbakeholdne avstander
%  - tittel formatert som et kapittel
% =================================================
\RequirePackage{tocloft}

\renewcommand{\cfttoctitlefont}{\Huge\scshape}
\renewcommand{\cftaftertoctitle}{\par\vspace{2ex}}

\renewcommand{\cftchapleader}{\hfill}
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

\setlength{\cftchapnumwidth}{2.5em}
\setlength{\cftsecnumwidth}{3.0em}
\setlength{\cftsubsecnumwidth}{3.5em}

\setlength{\cftbeforechapskip}{6pt}
\setlength{\cftbeforesecskip}{2.5pt}
\setlength{\cftbeforesubsecskip}{1.5pt}

\newcommand{\booktoc}{%
  \tableofcontents
}


% =================================================
% TOPPTEKST OG SIDESTILER
%
% fancyhdr brukes eksplisitt og lokalt.
% Ingen global redefinering av 'plain'.
%
% Posisjonskoder brukt nedenfor:
%   L = venstre, C = midten, R = høyre
%   E = partallsside (verso), O = oddetallsside (recto)
% I tosidig oppsett står sidetallene mot ytterkanten,
% og seksjons-/kapittelmerker mot innerkanten.
% =================================================
\RequirePackage{fancyhdr}
\setlength{\headheight}{14pt}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ------------------ Hovedmaterialesider -----------
\fancypagestyle{chapterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

% ------------------ Kapittelåpningssider ----------
\fancypagestyle{chapteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}

% ------------------ Frontmaterialesider -----------
\fancypagestyle{frontmatterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

\fancypagestyle{frontmatteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}


% =================================================
% PATCH KUN HOVEDMATERIALE-KAPITTELÅPNINGER
%
% Omdirigerer kapittelåpningssider bort fra 'plain'
% uten å påvirke frontmateriale-oppførselen.
% =================================================
\RequirePackage{etoolbox}
\makeatletter

\patchcmd{\chapter}
  {\thispagestyle{plain}}
  {\thispagestyle{chapteropen}}
  {}{}

\makeatother


% =================================================
% MAKRO FOR FRONTMATERIALE-KAPITLER
%
% Brukes til Forord, Takk, osv.
%
% Designmål:
%  - unummerert
%  - litt mindre enn hovedkapitler
%  - venstrejustert
%  - tilbakeholdne avstander
%  - korrekt sidestil-oppførsel
%
% MERK:
%  - Innrykk av første avsnitt håndteres eksplisitt
%    i dokumentet med \noindent.
% =================================================
\makeatletter

\newcommand{\frontchapter}[1]{%
  \cleardoublepage
  \thispagestyle{frontmatteropen}

  % Sett løpende topptekst (unngår "Kapittel 0")
  \markboth{#1}{}

  % Overskriftsblokk
  \vspace*{3ex}
  {\noindent\LARGE\bfseries #1\par}
  \vspace{3ex}
}

\makeatother


% =================================================
% TOPPTEKSTMARKERINGER
%
% Rene, minimale løpende topptekster.
% =================================================
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}

\pagestyle{chapterstyle}


% =================================================
% TITTELSIDE
%
% Eksplisitt, robust tittelside.
% Ingen avhengighet av \maketitle.
% =================================================
\makeatletter

\def\@subtitle{}
\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}

\newcommand{\booktitlepage}{%
  \begin{titlepage}
    \thispagestyle{empty}

    \vspace*{0.18\textheight}

    \begin{center}
      {\Huge\scshape \@title \par}

      \ifx\@subtitle\@empty\else
        \vspace{1.6em}
        {\Large\itshape \@subtitle \par}
      \fi

      \vspace{3em}
      {\large \@author \par}
    \end{center}

    \vfill

    \begin{center}
      {\normalsize\itshape \@date \par}
    \end{center}
  \end{titlepage}
}

\makeatother


% =================================================
% DEDIKASJONSSIDE
%
% Recto-side med en kort linje i kursiv,
% sentrert horisontalt, plassert i øvre tredjedel
% av siden. Følges av en tom verso.
%
% Bruk:
%   \dedicationpage{Til mine foreldre.}
% =================================================
\newcommand{\dedicationpage}[1]{%
  \cleardoublepage
  \thispagestyle{empty}
  \vspace*{0.25\textheight}
  \begin{center}
    \itshape #1
  \end{center}
  \vfill
  \cleardoublepage
}


% =================================================
% SITERINGER
%
% Numeriske superskrift-siteringer, plassert akkurat
% der de er skrevet i kilden (ingen automatisk flytting
% forbi tegnsetting). Flere nøkler sorteres og
% komprimeres til intervaller, f.eks. \cite{a,b,c} -> 1-3.
%
% Bruk:
%   \cite{nokkel}      i teksten
%   \bibliography{...} i main.tex bakmateriale
% =================================================
\RequirePackage[superscript,nomove]{cite}

% Etiketter i bibliografilisten: "1." istedenfor "[1]",
% for å matche superskript-stilen i teksten.
\makeatletter
\renewcommand{\@biblabel}[1]{#1.}
\makeatother


% =================================================
% HYPERLENKER
%
% MÅ LASTES SIST.
% Subtilt, trygt for trykk.
% =================================================
\RequirePackage{xcolor}
\definecolor{linkblack}{RGB}{0,0,0}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=linkblack,
  citecolor=linkblack,
  urlcolor=linkblack,
  linktoc=page
}

% Overstyrer hyperrefs standard om å fargelegge
% sidetall i innholdsfortegnelsen — beholdes svarte
% slik at de matcher resten.
\makeatletter
\renewcommand{\cftchappagefont}{\normalfont\color{black}}
\renewcommand{\cftsecpagefont}{\normalfont\color{black}}
\renewcommand{\cftsubsecpagefont}{\normalfont\color{black}}
\makeatother


% =================================================
% SLUTT PÅ FIL
% =================================================
\endinput
