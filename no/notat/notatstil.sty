\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notatstil}[2026/05/07 v1.2 Notatstil — JHEP/CUP-inspirert]

% =================================================
% FILOSOFI
%
% Denne stilen er for langformede notater i
% teoretisk fysikk og matematikk (ikke artikler).
%
% Designprioriteringer:
%  - rolig vertikal rytme
%  - lesbar matematikk
%  - sterk men stille struktur
%  - typografisk konsistens
%
% Stilen er bevisst konservativ.
% =================================================


% =================================================
% FONT OG MIKROTYPOGRAFI
% =================================================
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% =================================================
% SIDEGEOMETRI (A4, SYMMETRISK)
%
% Optimalisert for:
%  - utskrevne notater
%  - lange utledninger
%  - margannoteringer ved behov
% =================================================
\RequirePackage[
  a4paper,
  left=3.0cm,
  right=3.0cm,
  top=2.7cm,
  bottom=3.0cm
]{geometry}


% =================================================
% AVSNITT- OG LINJEAVSTAND
%
% Klassisk boklignende avsnitt:
%  - innrykk
%  - ingen mellomrom mellom avsnitt
% =================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.07}


% =================================================
% AVSTAND RUNDT VISTE LIGNINGER
%
% Notater drar nytte av rommelig avstand rundt viste
% formler, særlig etter korte innledende linjer
% ("slik at", "altså", osv.).
%
% Kort-skip og normal-skip er bevisst likestilt for
% å unngå tetthet.
% =================================================
\setlength{\abovedisplayskip}{14.2pt plus 4.25pt minus 4.25pt}
\setlength{\belowdisplayskip}{14.2pt plus 4.25pt minus 4.25pt}

\setlength{\abovedisplayshortskip}{14.2pt plus 4.25pt minus 4.25pt}
\setlength{\belowdisplayshortskip}{14.2pt plus 4.25pt minus 4.25pt}


% =================================================
% SEKSJONERING
%
% Strukturelt hierarki indikeres av:
%  - størrelse
%  - vekt
%  - kapiteler
%
% Underunderseksjoner er bevisst utelatt.
% =================================================
\RequirePackage{titlesec}

% Seksjoner
\titleformat{\section}
  {\normalfont\Large\bfseries\scshape}
  {\thesection.}{0.8em}{}

\titlespacing*{\section}
  {0pt}{4.5ex plus 1.5ex minus .5ex}{2.4ex plus .4ex}

% Underseksjoner
\titleformat{\subsection}
  {\normalfont\large\bfseries\scshape}
  {\thesubsection.}{0.8em}{}

\titlespacing*{\subsection}
  {0pt}{4.0ex plus 1.2ex minus .4ex}{1.8ex plus .4ex}


% =================================================
% SIDESTIL
%
% Notater bruker enkle sider:
%  - ingen løpende topptekst
%  - sidetall sentrert i bunnen
% =================================================
\pagestyle{plain}


% =================================================
% TITTELBLOKK
%
% Rolig, bokinspirert tittelutforming.
% Bruker \maketitle for enkelhet og robusthet.
% =================================================
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \begin{center}
    {\Large\scshape \@title \par}
    \vspace{2.0em}
    {\normalsize \@author \par}
    \vspace{0.6em}
    {\small \@date \par}
  \end{center}
  \vspace{2.5em}
}
\makeatother


% =================================================
% SAMMENDRAG
%
% Smalere tekstblokk, klassisk stil.
% Avstand tilpasset notatets generelle rytme.
%
% Vi redefinerer abstract-omgivelsen for å:
%  - sentrere en "Sammendrag"-etikett i kapiteler
%  - begrense brødteksten til 88 % av tekstbredden
%  - tilbakestille linjeavstanden i blokken
%
% \abstractname er babel-lokalisert
% (norsk: "Sammendrag", engelsk: "Abstract").
% =================================================
\makeatletter
\renewenvironment{abstract}{%
  \par
  \centering
  {\small\bfseries\scshape \abstractname\par}
  \vspace{10pt}
  \begin{minipage}{0.88\textwidth}
    \small
    \setstretch{1.0}
}{%
  \end{minipage}
  \par
  \vspace{2.2em}
}
\makeatother


% =================================================
% INNHOLDSFORTEGNELSE
%
% JHEP-stil ramme:
%
% ----------------------------
% Innhold
% seksjoner
% ----------------------------
%
% Punktlinjer fjernes eksplisitt via dokumenterte
% grensesnitt (tocloft), ikke interne kommandoer.
% =================================================
\RequirePackage{tocloft}
\RequirePackage{etoolbox}

% Ingen punktlinjer
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

% Valgfri breddejustering (trygge standardverdier)
\setlength{\cftsecnumwidth}{2.5em}
\setlength{\cftsubsecnumwidth}{3.0em}

% Vannrette linjer over og under innholdsfortegnelsen.
% \pretocmd / \apptocmd (fra etoolbox) injiserer kode
% før/etter \tableofcontents uten å overskrive den.
\newcommand{\afterTocSpace}{\bigskip\medskip}
\newcommand{\afterTocRuleSpace}{\bigskip\bigskip}

\pretocmd{\tableofcontents}{%
  \hrule
  \vspace{1.5ex}
}{}{}

\apptocmd{\tableofcontents}{%
  \afterTocSpace
  \hrule
  \afterTocRuleSpace
}{}{}


% =================================================
% SITERINGER
%
% Numeriske siteringer i hakeparenteser, sortert og
% komprimert til intervaller, f.eks. \cite{a,b,c} -> [1-3].
%
% natbib må lastes før hyperref.
%
% Bruk:
%   \cite{nokkel}             [1]
%   \cite{n1,n2,n3}           [1-3]
%   \bibliographystyle{unsrtnat} i main.tex
%   \bibliography{...}        i main.tex
% =================================================
\RequirePackage[numbers,sort&compress]{natbib}


% =================================================
% HYPERLENKER
%
% Mørkerød, trygt for trykk.
% Lastes sist.
% =================================================
\RequirePackage{xcolor}
\definecolor{darkred}{RGB}{120,20,20}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred,
  linktoc=page
}


% =================================================
% SLUTT PÅ FIL
% =================================================
\endinput
