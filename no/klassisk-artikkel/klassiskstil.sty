\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{klassiskstil}[2026/05/07 v1.0 Klassisk artikkelstil]

% =================================================
% FILOSOFI
%
% Klassisk, ren artikkelstil. Definerer formatering,
% avstander og hjelpepakker. Font og matematikkpakker
% velges i main.tex slik at hver artikkel kan tilpasses.
% =================================================


% =================================================
% FONTKODING OG MIKROTYPOGRAFI
%
% Selve fonten velges i main.tex (mlmodern, lmodern,
% stix2, ...). Her settes kun T1-koding og mikrotypografi
% som er nyttig uansett font.
% =================================================
\RequirePackage[T1]{fontenc}
\RequirePackage{microtype}


% =================================================
% SIDEGEOMETRI
%
% Symmetriske marger på 3,5 cm gir en tekstbredde på
% 14 cm — litt romsligere enn article-standarden,
% men fortsatt innenfor optimal lesbarhet for 12pt.
% =================================================
\RequirePackage{geometry}
\geometry{a4paper, margin=3.5cm}


% =================================================
% AVSNITT- OG LINJEAVSTAND
%
% \linespread{1.2} gir omtrent 1,2x den naturlige
% grunnlinjen — komfortabelt for 12pt brødtekst.
% Orddeling er slått av, så ord brytes aldri over
% linjeskift.
% =================================================
\RequirePackage{setspace}
\linespread{1.2}

\RequirePackage[none]{hyphenat}


% =================================================
% AVSTAND RUNDT VISTE LIGNINGER
%
% En halv centimeter over og under viste ligninger.
% Holder matematikken visuelt forankret i prosaen
% uten å trenge seg på.
% =================================================
\setlength{\abovedisplayskip}{0.5cm}
\setlength{\abovedisplayshortskip}{0.5cm}
\setlength{\belowdisplayskip}{0.5cm}
\setlength{\belowdisplayshortskip}{0.5cm}


% =================================================
% TABELLER
%
% booktabs gir profesjonelle horisontale streker
% (\toprule, \midrule, \bottomrule — aldri vertikale).
% \arraystretch=1.7 gir vertikal luft mellom rader så
% tabellene ikke føles trange ved denne tekststørrelsen.
% =================================================
\RequirePackage{booktabs}
\renewcommand{\arraystretch}{1.7}


% =================================================
% FIGURTEKSTER
%
% Hengende innrykk, små, fet etikett, kursiv tekst.
% =================================================
\RequirePackage[
  hang,
  small,
  labelfont=bf,
  up,
  textfont=it,
  up
]{caption}


% =================================================
% FARGER OG GRAFIKK
%
% Figurer søkes i ./figurer/. Du kan da skrive
% \includegraphics{filnavn} uten å oppgi mappen.
% =================================================
\RequirePackage[svgnames]{xcolor}
\RequirePackage{graphicx}
\graphicspath{{figurer/}}


% =================================================
% LISTER OG BOKSER
%
% enumitem  — finkontroll over lister
%             (egendefinerte etiketter, avstander,
%             [resume], ...)
% tcolorbox — fargede ramme-bokser for merknader,
%             definisjoner, advarsler, osv.
% =================================================
\RequirePackage{enumitem}
\RequirePackage{tcolorbox}


% =================================================
% FLYTENDE OG INNFLETTEDE FIGURER
%
% float    — gir [H]-plassering (låst, "akkurat her")
%            for figurer og tabeller
% wrapfig  — tekst som flyter rundt små figurer
% subfig   — flere underfigurer side ved side
% =================================================
\RequirePackage{float}
\RequirePackage{wrapfig}
\RequirePackage{subfig}


% =================================================
% LINJEBRYTING
%
% emergencystretch lar LaTeX strekke linjer i nødstilfeller
% — gir færre overfull-bokser uten manuell justering.
% hbadness=99999 demper LaTeX' klager på underfull bokser.
% =================================================
\setlength{\emergencystretch}{3em}
\hbadness=99999


% =================================================
% SITERINGER
%
% Numeriske siteringer i hakeparenteser, sortert og
% komprimert til intervaller, f.eks. \cite{a,b,c} -> [1-3].
%
% Bruk:
%   \cite{nokkel}             [1]
%   \cite{n1,n2,n3}           [1-3]
%   \bibliographystyle{unsrtnat} i main.tex
%   \bibliography{...}        i main.tex
% =================================================
\RequirePackage[numbers,sort&compress]{natbib}


% =================================================
% SLUTT PÅ FIL
% =================================================
\endinput
